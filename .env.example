# Copy to .env.local and fill privately. No real credentials belong in Git.
# Core: configure public variables before next build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Optional fallback for some admin clients; does not replace every indexing path.
# SUPABASE_SECRET_KEY=
# Optional stable server-side session signing secret.
# AUTH_SESSION_POLICY_SECRET=

# Optional Maps: use a key issued for current NCP Maps / Web Dynamic Map.
NEXT_PUBLIC_NAVER_MAP_KEY_ID=
# NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Optional server-side NAVER API HUB local/place search (not the Maps secret).
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# New owner/staff signup: enable only after Supabase email/SMTP, migrations
# 038/039 and the six-digit email policy have been verified.
NEXT_PUBLIC_SIGNUP_EMAIL_OTP_LENGTH=6
OWNER_STAFF_EMAIL_OTP_READY=false
OWNER_STAFF_EMAIL_FIRST_OTP_POLICY_READY=false

# Optional external indexing endpoints. RAG_INDEXING_SECRET requires 32+ chars.
# RAG_INDEXING_SECRET=
# WEBHOOK_SECRET=
# Optional DB-backed recipe metadata; leave off until its schema is ready.
# RAG_RECIPE_SUPPORT_STORAGE=0

# Render supplies PORT. Set NODE_VERSION in Render, not as an app credential.
# Use NODE_ENV=production on Render; normal next dev sets development locally.
# Do not add trial preloads, ILITDA_MANUAL_*, local ledgers or debug flags here.