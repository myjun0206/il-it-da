{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "tests/rag/**/*.ts",
    "lib/**/*.ts",
    "app/api/rag/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
